{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|icon\\.svg|manifest\\.json|sw\\.js|pwa-192x192\\.png|pwa-512x512\\.png|pwa-maskable-512x512\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
